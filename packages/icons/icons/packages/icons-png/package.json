{
  "name": "@vnkr-labs/icons-png",
  "version": "1.0.0",
  "description": "A set of free MIT-licensed high-quality SVG icons for you to use in your web projects.",
  "homepage": "https://vnkr.vn/icons",
  "bugs": {
    "url": "https://vnkr.vn/git/icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://vnkr.vn/git/icons.git",
    "directory": "packages/icons-png"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:icons",
    "build:icons": "node build.mjs",
    "clean": "find dist -mindepth 1 -delete 2>/dev/null; rm -rf dist && find . ! -name '.gitkeep' -path '*/icons/*' -exec rm -rf {} +",
    "copy:license": "cp ../../LICENSE ./LICENSE"
  },
  "amdName": "VNKRIconsPng",
  "files": [
    "icons/**/*.png"
  ],
  "exports": {
    "./*": [
      "./icons/*"
    ]
  },
  "dependencies": {
    "@vnkr-labs/icons": "workspace:"
  },
  "keywords": [
    "icons",
    "svg",
    "png",
    "iconfont",
    "react",
    "front-end",
    "web"
  ],
  "devDependencies": {},
  "peerDependencies": {},
  "optionalDependencies": {}
}