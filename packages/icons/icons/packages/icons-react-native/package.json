{
  "name": "@vnkr-labs/icons-react-native",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": { "name": "VNKR", "email": "studio@vnkr.vn", "url": "https://vnkr.vn" },
  "description": "A set of free MIT-licensed high-quality SVG icons for you to use in your web projects.",
  "homepage": "https://vnkr.vn/icons",
  "bugs": {
    "url": "https://vnkr.vn/git/icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://vnkr.vn/git/icons.git",
    "directory": "packages/icons-react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/vnkr-icons-react-native.cjs",
  "types": "./dist/cjs/vnkr-icons-react-native.d.cts",
  "module": "./dist/esm/vnkr-icons-react-native.mjs",
  "amdName": "VNKRIconsReactNative",
  "react-native": "./dist/esm/vnkr-icons-react-native.mjs",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/vnkr-icons-react-native.d.cts",
        "default": "./dist/cjs/vnkr-icons-react-native.cjs"
      },
      "import": {
        "types": "./dist/vnkr-icons-react-native.d.ts",
        "default": "./dist/esm/vnkr-icons-react-native.mjs"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/cjs/icons/*.d.cts",
        "default": "./dist/cjs/icons/*.cjs"
      },
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/esm/icons/*.mjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:icons && pnpm typecheck && pnpm run build:bundles",
    "build:icons": "node build.mjs",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "find dist -mindepth 1 -delete 2>/dev/null; rm -rf dist && find . ! -name '.gitkeep' -path '*/src/icons/*' -exec rm -rf {} +",
    "typecheck": "tsc",
    "imports-check": "attw $(npm pack)"
  },
  "dependencies": {
    "@vnkr-labs/icons": "workspace:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "^0.73.5",
    "react-native-svg": "^15.0.0",
    "react-test-renderer": "catalog:"
  },
  "peerDependencies": {
    "react": ">= 16.5.1",
    "react-native-svg": ">= 13.0.0"
  },
  "optionalDependencies": {}
}