{
  "name": "@vnkr-labs/icons-solidjs",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": { "name": "VNKR", "email": "studio@vnkr.vn", "url": "https://vnkr.vn" },
  "description": "A set of free MIT-licensed high-quality SVG icons for you to use in your web projects.",
  "homepage": "https://vnkr.vn/icons",
  "bugs": {
    "url": "https://vnkr.vn/git/icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://vnkr.vn/git/icons.git",
    "directory": "packages/icons-solidjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "amdName": "VNKRIconsSolidjs",
  "exports": {
    ".": {
      "solid": "./dist/source/vnkr-icons-solidjs.js",
      "import": {
        "types": "./dist/types/vnkr-icons-solidjs.d.ts",
        "default": "./dist/esm/vnkr-icons-solidjs.js"
      },
      "browser": {
        "types": "./dist/types/vnkr-icons-solidjs.d.ts",
        "default": "./dist/esm/vnkr-icons-solidjs.js"
      },
      "require": {
        "types": "./dist/types/vnkr-icons-solidjs.d.ts",
        "default": "./dist/cjs/vnkr-icons-solidjs.js"
      },
      "node": {
        "default": "./dist/cjs/vnkr-icons-solidjs.js",
        "types": "./dist/types/vnkr-icons-solidjs.d.ts"
      }
    }
  },
  "main": "./dist/cjs/vnkr-icons-solidjs.js",
  "module": "./dist/esm/vnkr-icons-solidjs.js",
  "types": "./dist/types/vnkr-icons-solidjs.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:icons && pnpm typecheck && pnpm run build:bundles",
    "build:icons": "node build.js",
    "build:bundles": "rollup -c ./rollup.config.js",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "find dist -mindepth 1 -delete 2>/dev/null; rm -rf dist && find . ! -name '.gitkeep' -path '*/src/icons/*' -exec rm -rf {} +",
    "test": "vitest run",
    "typecheck": "tsc",
    "imports-check": "attw $(npm pack)"
  },
  "dependencies": {
    "@vnkr-labs/icons": "workspace:"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.6",
    "rollup-preset-solid": "^2.0.1",
    "vite-plugin-solid": "^2.10.1",
    "solid-js": "^1.8.15",
    "rollup": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.4.7"
  },
  "optionalDependencies": {}
}