{
  "name": "@vnkr-labs/icons-vue",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": { "name": "VNKR", "email": "studio@vnkr.vn", "url": "https://vnkr.vn" },
  "description": "A set of free MIT-licensed high-quality SVG icons for you to use in your web projects.",
  "homepage": "https://vnkr.vn/icons",
  "bugs": {
    "url": "https://vnkr.vn/git/icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://vnkr.vn/git/icons.git",
    "directory": "packages/icons-vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/vnkr-icons-vue.cjs",
  "module": "./dist/esm/vnkr-icons-vue.mjs",
  "types": "./dist/vnkr-icons-vue.d.ts",
  "amdName": "VNKRIconsVue",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:icons && pnpm run build:bundles",
    "build:icons": "node build.mjs",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "find dist -mindepth 1 -delete 2>/dev/null; rm -rf dist && find . ! -name '.gitkeep' -path '*/src/icons/*' -exec rm -rf {} +",
    "test": "vitest run",
    "imports-check": "attw $(npm pack)"
  },
  "dependencies": {
    "@vnkr-labs/icons": "workspace:"
  },
  "peerDependencies": {
    "vue": ">=3.0.1"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.4.20",
    "@vue/test-utils": "2.4.4",
    "vue": "^3.4.20"
  },
  "optionalDependencies": {}
}