{
  "name": "@vnkr-labs/icons",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "VNKR",
    "email": "studio@vnkr.vn",
    "url": "https://vnkr.vn"
  },
  "description": "A set of high-quality SVG icons for VNKR System.",
  "repository": {
    "type": "git",
    "url": "git+https://vnkr.vn/git/icons.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "amdName": "VNKRIcons",
  "exports": {
    "./*": [
      "./icons/*"
    ]
  },
  "sideEffects": false,
  "files": [
    "icons.json",
    "axq-nodes-filled.json",
    "axq-nodes-outline.json",
    "icons/*",
    "categories/*",
    "docs/*"
  ],
  "homepage": "https://vnkr.vn/icons",
  "bugs": {
    "url": "https://vnkr.vn/issues"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run copy && pnpm run build:icons && pnpm run build:docs",
    "build:icons": "node build.mjs",
    "build:docs": "cp -r ../../docs/* ./docs/",
    "copy": "pnpm run copy:license",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "find dist -mindepth 1 -delete 2>/dev/null; rm -rf dist && find . ! -name '.gitkeep' -path '*/categories/*' -exec rm -rf {} + && find dist -mindepth 1 -delete 2>/dev/null; rm -rf dist && find . ! -name '.gitkeep' -path '*/icons/*' -exec rm -rf {} +"
  },
  "keywords": [
    "icons",
    "svg",
    "vnkr",
    "design-system",
    "react",
    "front-end",
    "web"
  ],
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {},
  "optionalDependencies": {}
}
