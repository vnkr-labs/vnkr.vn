# ──────────────────────────────────────────────────────────────────────────────
# infra/monitoring/crontab.example
# Giai đoạn 6: Cron Jobs Schedule
# Sao chép vào crontab với: crontab infra/monitoring/crontab.example
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""
VPX_RPC_URL=http://127.0.0.1:8899
SQX_RPC_URL=http://127.0.0.1:8545
TREASURY_ADDRESS=your_treasury_address_here
TREASURY_KEY_PATH=/opt/axioledger/keys/treasury-engine.json
ALERT_WEBHOOK_URL=https://hooks.example.com/your-webhook

# ── Node Health Check — every 5 minutes ──────────────────────────────────────
*/5 * * * * /opt/axioledger/scripts/cron/node-health-check.sh >> /var/log/axioledger/health.log 2>&1

# ── Treasury Gas Fee Sweep — every hour ──────────────────────────────────────
0 * * * * /opt/axioledger/scripts/cron/treasury-sweep.sh >> /var/log/axioledger/treasury.log 2>&1

# ── File Integrity Monitoring — every night at 02:00 UTC ─────────────────────
0 2 * * * /opt/axioledger/scripts/cron/fim-scan.sh >> /var/log/axioledger/fim.log 2>&1

# ── Log rotation — weekly (Sunday 03:00 UTC) ─────────────────────────────────
0 3 * * 0 find /var/log/axioledger -name "*.log" -mtime +30 -delete
