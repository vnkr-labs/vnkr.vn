{
  "name": "@axioledger/axio-design-system",
  "version": "2.0.0",
  "description": "AXQ Design System — Variable Token Architecture, React components, Crypto UI",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css",
    "./fonts": "./dist/fonts.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "tokens",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:tokens": "node scripts/build-tokens.js",
    "build:icons": "node scripts/build-icon-paths.mjs",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-themes": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "storybook": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "license": "BSL-1.1",
  "author": "AxioLedger Core Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/axioledger/axioledger-monorepo",
    "directory": "packages/design-system"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
