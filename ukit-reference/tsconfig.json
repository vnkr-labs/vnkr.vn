{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@axioledger/ans-resolver": ["./packages/ans-resolver/src/index.ts"],
      "@axioledger/zkp-crypto-lib": ["./packages/zkp-crypto-lib/src/index.ts"],
      "@axioledger/evm-interop": ["./packages/evm-interop/src/index.ts"],
      "@axioledger/axio-design-system": ["./packages/design-system/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*"],
  "exclude": ["node_modules", "dist", "target", "apps", "core-nodes", "smart-contracts"]
}
